    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "express": "^5.1.0",
    "groq-sdk": "^1.6.0",
    "mongoose": "^8.9.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^10.1.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
