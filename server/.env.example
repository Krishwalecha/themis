NODE_ENV=development # "production" on your host
THEMIS_PORT=4000 # port the API listens on
MONGODB_URI= # empty = local database for development; required in production
CORS_ORIGIN=http://localhost:5173 # where the web app runs
THEMIS_APP_URL=http://localhost:5173 # public app address, for alert links and Google sign-in
THEMIS_ALLOW_SIGNUP=true # false to close sign-ups
GROQ_API_KEY= # enables AI summaries
GROQ_MODEL=openai/gpt-oss-120b # Groq model for AI summaries
GOOGLE_CLIENT_ID= # Continue with Google (optional)
GOOGLE_CLIENT_SECRET= # Continue with Google (optional)
